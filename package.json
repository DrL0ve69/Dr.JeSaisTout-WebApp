{
  "name": "dr-je-sais-tout",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "npm run content:build",
    "build": "npm run content:build && ng build && npm run config:swa",
    "watch": "ng build --watch --configuration development",
    "prewatch": "npm run content:build",
    "test": "ng test",
    "pretest": "npm run content:build",
    "lint": "ng lint && eslint tools e2e playwright.config.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "e2e": "npm run typecheck:e2e && playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "config:swa": "node tools/deploiement/generer-config-swa.mjs",
    "content:build": "node tools/content-pipeline/build.mjs",
    "content:valider": "node tools/content-pipeline/valider.mjs",
    "content:valider:fixtures": "node tools/content-pipeline/valider.mjs --fixtures tools/content-pipeline/__fixtures__/invalides",
    "content:compiler": "node tools/content-pipeline/compiler-markdown.mjs",
    "content:poids": "node tools/content-pipeline/verifier-poids.mjs",
    "design:contrastes": "node tools/design/verifier-contrastes.mjs",
    "design:contrastes:check": "node tools/design/verifier-contrastes.mjs --check",
    "design:glyphes": "node tools/design/verifier-glyphes.mjs",
    "a11y:axe": "node tools/a11y/verifier-axe.mjs",
    "a11y:axe:auto-test": "node tools/a11y/verifier-axe.mjs --auto-test",
    "kb": "node tools/kb-search.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@azure/static-web-apps-cli": "^2.0.10",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@playwright/test": "^1.62.1",
    "@shikijs/transformers": "^4.4.3",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^20.17.19",
    "ajv": "^8.20.0",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.6.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "prettier": "^3.8.1",
    "sass": "^1.101.0",
    "shiki": "^4.4.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8",
    "yaml": "^2.9.0"
  }
}
